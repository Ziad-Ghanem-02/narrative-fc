# A PostgreSQL database containing both the Django tables and World Cup data.
# The application data source is normally a hosted Neon database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required to generate or revise AI stories.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://your-llm-provider.example/v1

# Use a long, unique value for shared or internet-accessible deployments.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
